DATABASE_URL=postgresql://case_user:case_password@localhost:5433/case_platform
PORT=3000
CORS_ORIGIN=http://localhost:5173
OIDC_ISSUER=http://localhost:8080/realms/bank-case-dev
OIDC_AUDIENCE=bank-case-api
OIDC_JWKS_URI=http://localhost:8080/realms/bank-case-dev/protocol/openid-connect/certs
OIDC_LOGOUT_URL=http://localhost:8080/realms/bank-case-dev/protocol/openid-connect/logout
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
OBJECT_STORAGE_URL_TTL_SECONDS=300
OUTBOX_DISPATCHER_ENABLED=true
OUTBOX_PUBLISHER=log
OUTBOX_POLL_MS=2000
OUTBOX_STALE_SECONDS=300
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=bank-case
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_TICK_MS=60000
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=600
TRUST_PROXY=false
# Destructive: de-identifies closed tickets past retention. Enable deliberately, after the bank approves retention schedules.
RETENTION_ENFORCEMENT_ENABLED=false
BUSINESS_TIMEZONE=Australia/Sydney
METRICS_TOKEN=
AUDIT_INTEGRITY_ENABLED=true
AUDIT_LIST_VIEWS=true
