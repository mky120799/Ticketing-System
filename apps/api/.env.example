DATABASE_URL=postgresql://case_user:case_password@localhost:5433/case_platform
PORT=3000
CORS_ORIGIN=http://localhost:5173
OIDC_ISSUER=http://localhost:8080/realms/bank-case-dev
OIDC_AUDIENCE=bank-case-api
OIDC_JWKS_URI=http://localhost:8080/realms/bank-case-dev/protocol/openid-connect/certs
OIDC_LOGOUT_URL=http://localhost:8080/realms/bank-case-dev/protocol/openid-connect/logout
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
OBJECT_STORAGE_URL_TTL_SECONDS=300
OUTBOX_DISPATCHER_ENABLED=true
OUTBOX_PUBLISHER=log
OUTBOX_POLL_MS=2000
OUTBOX_STALE_SECONDS=300
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=bank-case
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_TICK_MS=60000
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=600
TRUST_PROXY=false
# Destructive: de-identifies closed tickets past retention. Enable deliberately, after the bank approves retention schedules.
RETENTION_ENFORCEMENT_ENABLED=false
BUSINESS_TIMEZONE=Australia/Sydney
METRICS_TOKEN=
AUDIT_INTEGRITY_ENABLED=true
AUDIT_LIST_VIEWS=true
OBJECT_STORAGE_PUBLIC_ENDPOINT=
CLAMAV_HOST=
CLAMAV_PORT=3310
# Email: outbound (SMTP) and inbound (IMAP). Unset to disable. EMAIL_REFERENCE_SECRET keys the pseudonym for senders.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=cases@bank.example
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
EMAIL_REFERENCE_SECRET=
EMAIL_AUTO_ACK=true
EMAIL_MAX_TICKETS_PER_SENDER_HOUR=5
# Contact resolution: a bank-controlled lookup returning {"email","mobile"} for an opaque reference.
CRM_CONTACT_URL=
CRM_CONTACT_TOKEN=
ALLOW_DIRECT_ADDRESS_REFERENCES=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# Customer portal (separate customer identity provider; disabled unless set)
PORTAL_OIDC_ISSUER=
PORTAL_OIDC_AUDIENCE=bank-case-portal-api
PORTAL_OIDC_JWKS_URI=
PORTAL_MAX_REQUESTS_PER_HOUR=10
PORTAL_MAX_MESSAGES_PER_HOUR=30
# Authentication hardening (all optional; recommended in production)
# Only accept tokens issued to these applications (azp / client_id), comma-separated
AUTH_ALLOWED_CLIENTS=
# Refuse tokens the IdP no longer considers active (RFC 7662). Needs a confidential client allowed to introspect.
AUTH_INTROSPECTION_URL=
AUTH_INTROSPECTION_CLIENT_ID=
AUTH_INTROSPECTION_CLIENT_SECRET=
AUTH_INTROSPECTION_CACHE_SECONDS=30
AUTH_INTROSPECTION_FAIL_OPEN=false
# Central entitlement lookup returning {roles,queues,branch,department,legal_entity,country} for ?subject=
ENTITLEMENT_URL=
ENTITLEMENT_TOKEN=
ENTITLEMENT_CACHE_SECONDS=60
ENTITLEMENT_FAIL_OPEN=false
# Step-up for reveals, approvals, exports, subject access and legal holds: login must be this recent and/or have one of these acr values
STEP_UP_MAX_AGE_SECONDS=0
STEP_UP_ACR_VALUES=
AUDIT_REQUIRE_RESTRICTED_DB_ROLE=false
# Audit hardening
# Publish every audit event to the event bus (topic <prefix>.audit) for the SIEM. Metadata may contain staff-typed reasons.
AUDIT_STREAM_ENABLED=false
AUDIT_STREAM_INCLUDE_METADATA=false
# Ed25519 keys for signing audit anchors (generate with: node scripts/generate-anchor-keys.mjs)
AUDIT_ANCHOR_SIGNING_PRIVATE_KEY=
AUDIT_ANCHOR_PUBLIC_KEY=
REPORT_EXPORT_ENABLED=false
DATABASE_POOL_MAX=20
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_IDLE_IN_TRANSACTION_MS=60000
