{
  "name": "@bank-case/api",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --ext .ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.cjs --runInBand",
    "test:integration": "RUN_DB_INTEGRATION=1 NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-integration.cjs --runInBand",
    "migration:run": "node-pg-migrate up -m migrations -d DATABASE_URL",
    "intake:simulate": "node scripts/simulate-intake.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "fastify": "5.12.5",
    "imapflow": "^2.2.1",
    "jose": "^5.9.6",
    "kafkajs": "^2.2.4",
    "mailparser": "^3.9.33",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
