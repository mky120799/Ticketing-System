server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # add_header in a location discards inherited ones, so every location includes the same generated header set.
  include /etc/nginx/conf.d/security-headers.inc;

  # Deployment configuration generated at container start (see 40-runtime-config.sh).
  location = /config.js { alias /tmp/app-config/config.js; include /etc/nginx/conf.d/security-headers.inc; add_header Cache-Control "no-store" always; }
  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
  location /assets/ { include /etc/nginx/conf.d/security-headers.inc; add_header Cache-Control "public, max-age=31536000, immutable" always; try_files $uri =404; }
  location / { include /etc/nginx/conf.d/security-headers.inc; add_header Cache-Control "no-cache" always; try_files $uri /index.html; }
}
